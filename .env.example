# JWT Secret for API authentication (REQUIRED for production - 32+ chars)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# AES encryption key (32 bytes = 64 hex chars) and IV (16 bytes = 32 hex chars)
AES_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
AES_IV="abcdef9876543210abcdef9876543210"

# Email (SMTP) — for sending OTPs to voters (optional, OTP shown in console in dev)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="ATC Voting <noreply@atc.ac.tz>"

# SMS (Africa's Talking) — for sending OTPs via SMS (optional)
AT_API_KEY="your-africas-talking-api-key"
AT_USERNAME="sandbox"

# Vercel KV / Upstash Redis — for persistent storage across serverless functions (optional)
KV_URL="redis://default:password@host:port"
KV_REST_API_URL="https://us1-able-goat-12345.upstash.io"
KV_REST_API_TOKEN="your-token"

# Mock mode (set to true for Vercel demo without real blockchain)
NEXT_PUBLIC_MOCK_MODE="true"

# Admin credentials
ADMIN_USERNAME="soateco_admin"
ADMIN_PASSWORD="ATC_Secure2024!"
